# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
TIME_ZONE=UTC

# Base URL of this site (used to build absolute links inside emails, e.g. invitations)
SITE_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=postgres://teamflow:teamflow@db:5432/teamflow

# Redis
REDIS_URL=redis://redis:6379/0

# CSRF (only needed if you ever serve the site from more than one origin/domain)
CSRF_TRUSTED_ORIGINS=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TeamFlow <no-reply@teamflow.io>
